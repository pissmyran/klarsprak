# Values for deploying Klarspråk to your own Cloudflare account.
# Copy to a private file outside the repo, fill in, and render with tools/render.mjs
# (see README.md). Every __NAME__ placeholder in the code and in
# wrangler.jsonc is replaced with the value of NAME here.

# Host name the site is served on, and an optional second host (e.g. a
# spelling with å, ä or ö; either form works) that redirects to it. Leave
# ALIAS_HOST empty if you have none.
PUBLIC_HOST=klarsprak.example.com
ALIAS_HOST=
# Host names Turnstile answers may come from (comma separated).
TURNSTILE_HOSTNAMES=klarsprak.example.com

# D1 database: `npx wrangler d1 create <name>` prints both values.
D1_DATABASE_NAME=klarsprak
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000

# Turnstile (Cloudflare dashboard → Turnstile → Add site). The secret is a
# Worker secret: `npx wrangler secret put TURNSTILE_SECRET`. ADMIN_TOKEN too.
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Presentation. THEME_KEY_PREFIX names the browser storage key and cookie for
# the theme choice; THEME_COOKIE_DOMAIN (optional) shares that cookie with
# sibling sites under one parent domain; SITE_FAMILY labels the "forest" theme.
THEME_KEY_PREFIX=klarsprak
THEME_COOKIE_DOMAIN=
SITE_FAMILY=Skog
# Optional HTML paragraph on /varfor pointing to a related site.
RELATED_SITE_HTML=
